{
  // Modo Máquina: site estático (Next.js com output: 'export') + um Worker pequeno
  // que só responde em /api/* (newsletter e situação da fila do Instagram) e roda o cron do Instagram. Todo o resto é servido direto da pasta out/.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "modomaquina",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "modomaquina-newsletter",
      "database_id": "b4bd1351-7a92-4215-8897-d232a27598d9"
    }
  ],
  // A cada 5 minutos: publica no Instagram o que estiver na hora (fila/instagram.json).
  "triggers": { "crons": ["*/5 * * * *"] },
  "observability": { "enabled": true }
}
